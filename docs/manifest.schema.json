{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dsh-local manifest",
  "type": "object",
  "required": ["name", "components"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "targetPath", "action", "status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["vendor", "plugin", "community-plugin", "script", "config", "service", "skill"] },
          "name": { "type": "string" },
          "repo": { "type": ["string", "null"] },
          "upstream": { "type": ["string", "null"] },
          "localPath": { "type": ["string", "null"] },
          "targetPath": { "type": "string" },
          "action": { "enum": ["submodule", "copy-to-repo", "junction-or-copy", "manifest-only", "vendor-or-copy", "submodule-or-copy", "submodule-or-vendor"] },
          "branch": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
